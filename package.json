{
  "name": "brc20-indexer-api",
  "version": "1.0.0",
  "description": "Production-Grade BRC-20 Indexer and REST API for Bitcoin Ordinals",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "lint": "eslint src/ tests/"
  },
  "keywords": [
    "bitcoin",
    "brc20",
    "ordinals",
    "indexer",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.7",
    "compression": "^1.7.4",
    "decimal.js": "^10.4.3",
    "express": "^4.18.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60
      }
    }
  }
}
